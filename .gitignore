.storage/
.cloud/
.cache/
.HA_VERSION
.ha_run.lock
home-assistant_v2.db*
home-assistant.log*
*.db-shm
*.db-wal
deps/
tts/
backups/
blueprints/automation/homeassistant/
blueprints/script/homeassistant/
custom_components/*/__pycache__/
__pycache__/
*.pyc

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
